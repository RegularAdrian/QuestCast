<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#388EF4" android:endColor="#8B5CF6" />
            <stroke android:width="3dp" android:color="#BDEEFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#6E4FD1" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#287EDC" android:endColor="#7C4EE4" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
